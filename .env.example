# Copy to .env.local at the repo root and fill in.
#
#   cp .env.example .env.local
#
# Both apps and the import CLI read from this one file locally. On Vercel, set
# these per project instead — see docs/DEPLOYMENT.md for which var goes where.

# ---------------------------------------------------------------------------
# Supabase — Project Settings → Data API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable "anon" key. Safe for both apps: every query it makes is constrained
# by the row level security policies in supabase/migrations/0002_rls.sql.
SUPABASE_ANON_KEY=your-anon-key

# Secret "service_role" key. BYPASSES row level security entirely.
#
# Needed ONLY by tools/wp-import and the seed script, both run locally. Never set
# this on a deployed project — a blog or admin deployment has no legitimate use
# for it, and its presence turns RLS off for everything that reads it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# apps/blog — one deployment per blog
# ---------------------------------------------------------------------------
# Must match a `slug` value in the `sites` table.
SITE_SLUG=demo

# Shared secret authenticating the admin's cache-refresh calls. Must equal the
# `revalidate_secret` in that site's `site_secrets` row:
#
#   select revalidate_secret from site_secrets
#     where site_id = (select id from sites where slug = 'demo');
#
# Without it, publishing cannot update the live site.
REVALIDATE_SECRET=copy-from-site_secrets

# ---------------------------------------------------------------------------
# apps/admin — one deployment total
# ---------------------------------------------------------------------------
# Nothing extra. The admin needs only SUPABASE_URL and SUPABASE_ANON_KEY above:
# sign-in is email + password, so there is no redirect URL to configure.

# ---------------------------------------------------------------------------
# apps/blog — the coded marketing site (SITE_SLUG=nntm-capital only)
# ---------------------------------------------------------------------------
# The homepage's HighLevel survey needs no configuration: its id is public, so it
# is committed in apps/blog/components/marketing/brand.ts rather than set here.
# Leads submitted through it land in HighLevel, which stays the system of record.
#
# Google Tag Manager container, e.g. GTM-XXXXXXX. Carried over from the
# HighLevel site so ad attribution survives the DNS move. Leave unset on preview
# deployments so they do not report conversions into the live container.
#
# Add the Facebook pixel as a tag INSIDE this container rather than as a second
# hardcoded script — two copies of one pixel double-count conversions.
NEXT_PUBLIC_GTM_ID=

# ---------------------------------------------------------------------------
# apps/blog — lead capture (optional, any blog)
# ---------------------------------------------------------------------------
# Where a captured lead is forwarded after it is stored. This is what actually
# sends the lead magnet: an n8n webhook, a Supabase function, a CRM endpoint.
# Nothing in this codebase sends email.
#
# Leave unset and the feature still works end to end — the lead is stored and,
# where the offer has a file, the download link comes straight back. Wire the
# automation up afterwards.
#
# The row is committed BEFORE this is called and a failure here never fails the
# submission, so a broken automation costs the follow-up email, never the lead.
LEAD_WEBHOOK_URL=

# Sent as `x-webhook-secret` on that request, so the receiver can reject
# anything else that finds the URL. Optional; only meaningful over HTTPS.
LEAD_WEBHOOK_SECRET=

# Apex origin, e.g. https://example.com. Set this on the BLOG project only when
# you have an old `blog.` subdomain to retire: requests arriving on blog.<apex>
# are then 301'd to <apex>/blog/<path>, preserving inbound links and rankings.
# Leave unset and the redirect is skipped entirely.
SITE_APEX_URL=
