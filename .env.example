# Copy to .env.local at the repo root and fill in.
#
#   cp .env.example .env.local
#
# Both apps and the import CLI read from this one file locally. On Vercel, set
# these per project instead (see README).

# ---------------------------------------------------------------------------
# Supabase — Project Settings → Data API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable "anon" key. Safe for the blog: every query it makes is constrained
# by the row level security policies in supabase/migrations/0002_rls.sql.
SUPABASE_ANON_KEY=your-anon-key

# Secret "service_role" key. BYPASSES row level security entirely.
#
# Needed ONLY by tools/wp-import and the seed script, both run locally. Never set
# this on a deployed blog project — a blog deployment has no legitimate use for
# it, and its presence there turns a read-only site into a full-access one.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Which site this blog deployment serves
# ---------------------------------------------------------------------------
# Must match a `slug` value in the `sites` table. One Vercel project per blog,
# each with its own SITE_SLUG.
SITE_SLUG=demo
