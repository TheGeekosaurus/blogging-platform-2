# Copy to .env.local at the repo root and fill in.
#
#   cp .env.example .env.local
#
# Both apps and the import CLI read from this one file locally. On Vercel, set
# these per project instead — see docs/DEPLOYMENT.md for which var goes where.

# ---------------------------------------------------------------------------
# Supabase — Project Settings → Data API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable "anon" key. Safe for both apps: every query it makes is constrained
# by the row level security policies in supabase/migrations/0002_rls.sql.
SUPABASE_ANON_KEY=your-anon-key

# Secret "service_role" key. BYPASSES row level security entirely.
#
# Needed ONLY by tools/wp-import and the seed script, both run locally. Never set
# this on a deployed project — a blog or admin deployment has no legitimate use
# for it, and its presence turns RLS off for everything that reads it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# apps/blog — one deployment per blog
# ---------------------------------------------------------------------------
# Must match a `slug` value in the `sites` table.
SITE_SLUG=demo

# Shared secret authenticating the admin's cache-refresh calls. Must equal the
# `revalidate_secret` in that site's `site_secrets` row:
#
#   select revalidate_secret from site_secrets
#     where site_id = (select id from sites where slug = 'demo');
#
# Without it, publishing cannot update the live site.
REVALIDATE_SECRET=copy-from-site_secrets

# ---------------------------------------------------------------------------
# apps/admin — one deployment total
# ---------------------------------------------------------------------------
# Public origin of the admin itself. Magic-link emails point back here, so if it
# is wrong the sign-in link lands on the wrong host.
ADMIN_URL=http://localhost:3001
